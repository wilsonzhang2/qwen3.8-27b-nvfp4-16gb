[Unit]
Description=Qwen3.8-27B NVFP4 no-MTP 64K P2 Vision
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai
WorkingDirectory=/opt/llama.cpp-qwen38
Environment=MODEL=/opt/models/qwen3.8-27b/Qwen3.8-27B-NVFP4-Q5K-no-MTP.gguf
Environment=MMPROJ=/opt/models/qwen3.8-27b/mmproj-Qwen3.8-27B-F16.gguf
Environment=LLAMA_SERVER=/opt/llama.cpp-qwen38/build/bin/llama-server
Environment=HOST=0.0.0.0
Environment=PORT=8001
Environment=THREADS=7
ExecStart=/path/to/repository/scripts/run-64k-p2-vision.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

# Notes:
# - Replace /path/to/repository with the local clone path.
# - Keep the GPU dedicated to this service for the documented 16 GB memory envelope.
# - The matching F16 mmproj is intentionally kept on CPU by the launcher.
# - This example does not enable the experimental transient-FA patch; that is a build-time source modification.
